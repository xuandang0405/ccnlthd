# deployment/setup-docker.ps1 sinh .env.docker tu dong; khong sua backend/.env.
COMPOSE_PROJECT_NAME=trolyviet
DOCKER_ENV_FILE=.env.docker
DOCKER_WEB_PORT=8080
MYSQL_DATABASE=ccnlthd
MYSQL_USER=ccnlthd_app
# Dung mat khau URL-safe (chu/so), setup sinh chuoi ngau nhien.
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password

APP_ENV=development
APP_NAME=Tro Ly Viet
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_PUBLIC_URL=http://127.0.0.1:8080
FRONTEND_ORIGIN=http://127.0.0.1:8080
APP_DOMAIN=localhost
ACCESS_TOKEN_MINUTES=15
LOGIN_SESSION_HOURS=4

# Compose ghi de ket noi database va thu muc upload cho container.
DATABASE_BACKEND=sql
RATE_LIMIT_BACKEND=sql
UPLOAD_DIR=/data/uploads

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=50
GEMINI_ATTEMPT_TIMEOUT_SECONDS=10
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SEPAY_AUTH_MODE=
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_HMAC_TOLERANCE_SECONDS=300
PAYMENT_BANK_CODE=
PAYMENT_BANK_BIN=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
MAX_UPLOAD_BYTES=26214400
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_CELLS=1000000
