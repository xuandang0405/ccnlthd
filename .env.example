# Application
APP_ENV=development
APP_NAME=AI Sales Assistant
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
APP_DOMAIN=localhost
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# PostgreSQL / Redis (Docker service names)
POSTGRES_DB=sales_assistant
POSTGRES_USER=sales_assistant
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://sales_assistant:change-me@postgres:5432/sales_assistant
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_SQLITE_PATH=../.runtime/rate-limits.db

# AI - required only for real Gemini calls
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30

# Email reset flow remains disabled until a real provider is configured
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Telegram - configured and verified per organization in the application
TELEGRAM_PLATFORM_BOT_TOKEN=

# SePay/payment - values must come from the real account and official docs
SEPAY_AUTH_MODE=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
SEPAY_HMAC_TOLERANCE_SECONDS=300
PAYMENT_BANK_CODE=
PAYMENT_BANK_BIN=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
PAYMENT_PRO_PLAN_AMOUNT=

# Storage
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_CELLS=200000

# Frontend build
VITE_API_BASE_URL=/api
