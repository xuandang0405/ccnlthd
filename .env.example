# Application
APP_ENV=development
APP_NAME=AI Sales Assistant
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
APP_DOMAIN=localhost
ACCESS_TOKEN_MINUTES=15
LOGIN_SESSION_HOURS=4

# MySQL + SQLAlchemy (đổi mật khẩu khi chạy server)
DATABASE_BACKEND=sql
DATABASE_URL=mysql+aiomysql://root@127.0.0.1:3306/ccnlthd?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=sql
RATE_LIMIT_SQLITE_PATH=../.runtime/rate-limits.db

# AI - required only for real Gemini calls
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=50
GEMINI_ATTEMPT_TIMEOUT_SECONDS=10

# Email reset flow remains disabled until a real provider is configured
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Telegram - configured and verified per organization in the application
TELEGRAM_PLATFORM_BOT_TOKEN=

# SePay/payment - values must come from the real account and official docs
SEPAY_AUTH_MODE=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
SEPAY_HMAC_TOLERANCE_SECONDS=300
PAYMENT_BANK_CODE=
PAYMENT_BANK_BIN=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
PAYMENT_PRO_PLAN_AMOUNT=

# Storage (Windows không Docker: đổi UPLOAD_DIR thành storage/uploads trong backend/.env)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=26214400
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_CELLS=1000000

# Frontend build
VITE_API_BASE_URL=/api
