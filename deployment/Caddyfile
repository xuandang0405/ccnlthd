{$APP_DOMAIN:localhost} {
    encode zstd gzip

    @api path /api/* /health/* /docs* /redoc* /openapi.json
    handle @api {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
